#!/command/execlineb -S1

#set a known path
	/command/export PATH /command
	/command/importas Path_def PATH
#NB:messing with PATH is bad. use LAUNCHPATH to affect the thiings

#set up some emergency logging.
#
# because we expect that the log process isn't run it until the
# bootstrap is complete, we have to do something with our output.
# this solution lets the OS buffer it in named pipes until the
# logger is up, and then dumps them into the logger.
#
# If the logger comes up, the named pipes can be consumed by
# the adminstator to hopefully diagnose the problem


	getpid MyPid importas -Su MyPid
	backtick -ED "${1}_svscanboot.tmplog.${MyPid}" BufName_base {
	    /command/flattenpath ${1}_svscanboot:${0}
	}
	define BufName_def /tmp/${BufName_base}.tmpbuffer
	importas -uD $BufName_def LogPipe TMPLOG
	multidefine "0 1 2"
		{ stdin stdout stderr }
	foreground { /sbin/mkfifo -m 600 $LogPipe }
	foreground { /bin/echo 	redirfd -rnbf R_ALTERR $LogPipe }
	redirfd -rnbf R_ALTERR $LogPipe
	redirfd -wnbf W_ALTERR $LogPipe
	redirfd -wf DEVNULL /dev/null
	fdreserve 1
	multisubstitute {
		importas -ui R_Err	R_ALTERR
		importas -ui W_Err	W_ALTERR
		importas -ui null	DEVNULL
		importas -ui W_Out	FD0
	}
	fdmove -c $W_Out $W_Err
	fdswap $stderr $W_Err
	fdswap $stdout $W_Out


# Grab any environment overrides and clear the environment.
#
# A little bit rum.
# On one hand we're saying we don't want the enviroment to be
# polluted by the mess that is the system launch environment,
# on the other we're trusting it.


	backtick -E	StartTime 	{ /bin/date }
	getpid	 -E	MyPid
	backtick -E	dirname 	{ /usr/bin/dirname ${0} }
	backtick -xE	SuperDir_def	{ importas -D $dirname sd SUPERVISE_DIR
					  ifelse { eltest -d $sd }
						{ /bin/echo $sd }
						foreground {
							/bin/echo $dirname
						}
						fdmove 2 1
						/bin/echo Ignoring
						SUPERVISE_DIR : $sd
						not found
					}
	multisubstitute  {
		importas -D /var/log/${1}/${dirname}
					LogDir_def	LOGDIR

		importas 		LogUser_env	LOGUSER
	}

	emptyenv -lp

	export SUPERVISE_TAG	${1}	#promised supervise TAG
	export SUPERVISE_DIR	$SuperDir_def

# grab some details about the initial state



#work out what we were called as
	backtick SUPERVISE_DIR { /usr/bin/realpath ${dirname} }
	importas SuperDir_def SUPERVISE_DIR

#read defaults
	s6-envdir -I /etc/svscanboot/ENV
#read overrides based on call
	s6-envdir -I /etc/svscanboot/ENV.${1}
	s6-envdir -I ${0}.ENV
	s6-envdir -I ${0}.env
#read overrides based on updated settings
	s6-envdir -I /etc/svscanboot/${SuperDir_def}/ENV
	importas -D ${SuperDir_def} SuperDir_t2	SUPERVISE_DIR
	s6-envdir -I /etc/svscanboot/${SuperDir_t2}/ENV
	importas -D $1 Tag			SUPERVISE_TAG
	s6-envdir -I /etc/svscanboot/ENV-tag.${Tag}
	importas -D ${SuperDir_t2} new_dir	SUPERVISE_DIR
	s6-envdir -I ${SuperDir_t2}/.ENV

# get the path, for right or wrong, as long as it is set. But I repeat,
# unless the user knows what they are doing, they should be using LAUNCHPATH

	fdreserve 2
	multisubstitute {
		importas -D ${Path_def}		Path		PATH
		importas -D $LogDir_def		LogDir		LOGDIR
		importas	 		LogUser_EnvDir 	LOGUSER
		importas -uD "s6-svscan"	LogName		LOGNAME
		importas -D ${SuperDir_def}	SuperDir	SUPERVISE_DIR
		importas -ui			r_IdFilter	FD0
		importas -ui			w_IdFilter	FD1
	}

# logging is pretty important, and getting a bogus login user may leave
# the logging process writing as root, which is generally *A* *BAD* *THING*
# so rather than blindly trusting the adminstrator, as I'd normally
# prefer, we'll make sure the user exists. But If they want to set it to
# root, that's their choice.
#
# id is noisy if the user doesn't exist, so we swap stderr/null.
# This may mask other issues, but if id isn't working there are likely
# other issues.
#
# due to importas rendering the substitution name unusable for future
# substitions, we have to use rolling identifiers
#
# No such user messages are expected as part of the fallback path
# So those messages are suppressed. However they ought not be exec


	piperw $r_IdFilter $w_IdFilter
	background {
		foreground { /bin/echo IdFilter }
		fdmove -c $w_IdFilter $stdout	# Dirty. reuse to hold $stdout
		fdmove -c 1 2
		fdmove 0 $r_IdFilter
		foreground { /usr/bin/fgrep -v ": No such user" }
		fdmove 1 $w_IdFilter		# actually the held stdout
		/bin/echo IdFilter finished
	}
	fdclose $r_IdFilter

	backtick LogUser {
		forx -x0 -E TryLogUser {
			$LogUser_EnvDir	# from envdirs
			$LogUser_env	# from this scripts env
			${1}_log	# from the tag
			s6_log		# a popular choice
			_syslogd	# alpine, SomeBSDs
			syslogd		# Old Faithful
		}
		fdmove 2 $w_IdFilter
		/usr/bin/id -un $TryLogUser
	}
	ifthenelse { eltest -v LogUser } {
	} {
		fdmove 1 2
		/bin/echo No valid Log User found. Logging as running user
	}
	fdclose $w_IdFilter

# get the final overridden values, if the administrator has deleted variables,
# we go back to the deafult, not the moset recent value that worked. This is
# probably the intent, and we'd have to be more rigourous about collecting
# interim values otherwise. Arguably LaunchPath should defeult to Path
# but if they've been playing with PATH then they should set LAUNCHPATH too.
	multisubstitute {
		# available for children:
		importas -u			LogUser		LogUser
		importas -D ${1}		Tag		SUPERVISE_TAG

		#internal use:
		importas -uD ${Path_def}	LaunchPath	LAUNCHPATH
		importas -uD "s6-svscanboot"	LaunchCommand	SVSCANBOOT
		importas -uD ${LogDir}/${LogName}
						LogPath		LOGPATH
		importas -uD ${SuperDir}/"s6-svscan-log"
						Logger		LOGGER
	}
	# needs Logger from multisubstitute, so can;t be in it.
	importas -uD ${Logger}/"fifo"	LoggerFifo	LOGGERFIFO
	# becasue we defaulted these they may need setting in the environment
	export SUPERVISE_DIR	$SuperDir
	export SUPERVISE_TAG	$Tag
	export LOGUSER		$LogUser
	export LOGDIR		$LogDir

#tidy up
	background {
		fdclose $null
		fdmove 2 $W_Err
		backtick -E LogSleep { /bin/date }
		getpid logpid importas -Su logpid
		#give svscanboot time to build the logger
		foreground { /bin/sleep 5 }
		backtick -E LogWait { /bin/date }
		backtick -E ErrTo {
			ifelse { s6-svwait -U $Logger }
			{ /bin/echo $LoggerFifo }
			/bin/echo /dev/fd/$W_Out
			importas -E failure ?
			fdmove $stderr $W_Err
			fdswap $stdout $W_Err
			/bin/echo s6-svwait -U $Logger failed: $failure
		}
		backtick -E LogReady { /bin/date }
		redirfd -wnEf ErrDest $ErrTo
		getpid logpid2 importas -Su logpid2
		fdmove $stdout $ErrDest
		fdmove -c $stderr $stdout
		fdmove $stdin $R_Err
		backtick -E LogDump { /bin/date }
		foreground {
			/bin/echo Dumping bufferd log
			Start: $StartTime
			Pause for Logger create: $LogSleep
			Waited for Logger Up: $LogWait
			Logger Up: $LogReady
			Dump Starting: $LogDump
			}
		foreground { /bin/cat }
		backtick -E DrainDone { /bin/date }
		foreground { /bin/echo Bufferd Log Dump Complete: $DrainDone }
		foreground { /bin/rm $LogPipe }
	}

	fdclose $null
	fdclose $R_Err

	define -s LogUserFlag "-l $LogUser"

	backtick -E now { /bin/date }
	foreground { /bin/echo \
"Starting supervision on $SuperDir at $now
PATH=$LaunchPath $LaunchCommand -D $LogPath $LogUserFlag $SuperDir"
	}
	foreground { /usr/bin/printenv }

	#restore the real stdout/stderr
	fdmove $stdout $W_Out
	fdmove $stderr $W_Err

	export PATH ${LaunchPath}
	$LaunchCommand -D $LogPath $LogUserFlag $SuperDir

