#!/command/execlineb
explode-servicedir
s6-envdir -I ENV
multisubstitute {
	importas -SD	_s6_log			LOGUSER
	importas -ui			there	where
}
multisubstitute {
	importas -SD	$LOGUSER		LOGGROUP
	importas -SsuD 	"t s99000 n10" 		LOGCONTROL
	importas -SD  	${LOGDIR}/${there}	SERVICELOG
	importas -Su				EXTRALOG
}
foreground { mkdir -p $SERVICELOG }
foreground { /usr/sbin/chown ${LOGUSER}:${LOGGROUP} $SERVICELOG }
s6-setuidgid $LOGUSER 
s6-log $LOGCONTROL $SERVICELOG $EXTRALOG

