our $VERSION = '0.1';

use warnings;
use strict;

use Error ':try';
use IO::Handle;
use Getopt::Long qw(:config gnu_compat);
use Socket;
use Mail::SPF;
use Errno qw(EAGAIN);
use Time::HiRes qw(sleep);
use FindBin qw($Script);
use constant TRUE   => (0 == 0);
use constant FALSE  => not TRUE;
use constant ENV_OPTS => 1<<0;
use constant ARG_OPTS => 1<<1;
use constant REQ_OPTS => 1<<2;
use constant ANY_OPTS => ~0;

$SIG{'HUP'} = $SIG{'TERM'} = $SIG{'INT'} = sub {
    my $sig = shift;
    $sig = 'TERM' if ('HUP' eq $sig);
    $SIG{$sig} = 'IGNORE';
    kill('TERM', -$$);
    $SIG{'HUP'} = $SIG{'TERM'} = $SIG{'INT'} = 'DEFAULT';
    warn "$$: received $sig ($!)";
    exit 0;
};
my $stage = 0;    
my %opts = (
    "listeners" => {
	value => 5,
	stage => ENV_OPTS|ARG_OPTS,
	type => 'i',
	test => sub { my $v = shift;
		      return 1 <= $v
			  && 10 >= $v; },
	expl => 'must be between 1 and 10',
	notate => '<n>',
	desc => sub {
	    my $self = shift;
	    'Attempt to keep' 
		. ' ' . ($self->{notate}) 
		. ' Child processes ready'
	}
    }
    , "forkretries" => {
	value => 1,
	stage => ENV_OPTS|ARG_OPTS,
	type => 'i',
	test => sub { my $v = shift;
		      return 0 <= $v
			  && 100 >= $v; },
	expl => 'must be between 0 and 100',
	notate => '<n>',
	desc => sub {
	    my $self = shift;
	    'If a fork fails due to EAGAIN, retry up to'
		. ' ' . ($self->{notate}) 
		. ' times. EAGAIN is most likely to be caused by a'
		. ' conservative NPROC limiting the number of processes'
 		. ' under the user.'
	}
    }
    , "forkretrydelay" => {
	value => 200,
	stage => ENV_OPTS|ARG_OPTS,
	type => 'i',
	test => sub { my $v = shift;
		      return 50 <= $v
			  && 10000 >= $v; },
	expl => 'must be between 50 and 10000 msec'
	    . ' (0.05 and 10 seconds)',
	notate => '<msec>',
	desc => sub {
	    my $self = shift;
	    'If a fork fails due to EAGAIN, wait'
		. ' ' . ($self->{notate})
		. ' milliseconds before continuing.'
		. ' '
		. ' A minimum delay is imposed to alleviate a tight loop'
	}
    }
    , "help" => {
	value => FALSE,
	stage => ARG_OPTS,
	type => '!',
	test => sub { TRUE },
	desc => sub { 'print help usage and exit' },
    }
    , "scope" => {
	value => 'mfrom',
	stage => ENV_OPTS | ARG_OPTS | REQ_OPTS,
	type => 's',
	test => sub { my $v = shift;
		      return $v =~ m/^(mfrom|helo)$/
	},
	expl => 'only mfrom is recommended, but helo is supported',
	notate => '<type>',
	desc => sub { 'Which statement to check, MAIL FROM OR EHLO/HELO' },
    }
    , "TCPREMOTEIP" => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<ip address>',
	desc => sub {
	    ('The IP address of the host claiming the identity that is being'
	     . ' checked.  Can be either an IPv4 or an IPv6 address. '
	     . ' An IPv4-mapped IPv6 address (e.g."::ffff:192.168.0.1") is'
	     . ' treated as an IPv4 address.') },
    }
    , "HELOHOST" => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<hostname>',
	desc => sub {
	    ('The EHLO/HELO SMTP transaction parameter. Used for the'
	     . ' expansion of %{h} macros and during the policy evaluation of'
	     . ' the helo scope.') }
    }
    , "MAILFROM" => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<hostname>',
	desc => sub {
	    ('The MAIL FROM SMTP transaction parameter. Used for the'
	     . ' expansion of %{s} and ${o} macros and during the policy'
	     . ' evaluation of the mfrom scope.') }
    }
    , "debug" => {
	value => 1,
	stage => ANY_OPTS,
	type => 'i',
	desc => sub { 'set debug level' }
    }
    , "hostname" => {
	value => undef,
	stage => ANY_OPTS,
	type => 's',
	notate => '<label>',
	test => sub {
	    my $v = shift;
	    warn "hostname '$v' is too long (253)"
		unless $v =~ /^.{0,253}\.?$/;
	    warn "'$v' not a valid hostname"
		unless "$v." =~ m/^(?:[0-9a-zA-Z_](?:[-0-9a-zA-Z_]{0,61}[0-9a-zA-Z_])?\.)+\.?$/;
	    warn "hostname '$v' shouldn't contain _" if $v =~ m/_/;
	    warn "recommend a trailing dot on hostname '$v'"
		unless $v =~ m/\.$/;
	},
	desc => sub { 'the hostname to use for the reporting server' }
    }
);


# Helper Functions
##############################################################################
sub opt {my $i = shift; $opts{$i}->{value}}
my $gettype='';
sub validate_opts {
    my ($optname, $value) = @_;
    warn "validating '$optname' '$value' (@_)" if opt('debug');
    my $opt = $opts{$optname};
    my $reason;
    if (!defined $opt->{type}) {
	warn "undefined option type for $optname";
    } elsif ('i' eq $opt->{type}) {
	$reason = 'Expected an integer' unless ($value =~ m/^[-+]?[0-9]+$/) ;
    } elsif ('!' eq $opt->{type}) {
	$value = $value // FALSE ? TRUE : FALSE;
    } elsif ('s' eq $opt->{type}) {
	0;
    } else {
	warn "unrecognised option type '$opt->{type}' for $optname";
    }
    $reason = $opt->{expl} unless
	defined($reason) || !defined($opt->{test}) || $opt->{test}->($value);
    if ($reason) {
	warn "${gettype}${optname} = '${value}' : ${reason}"
	    . "\n( was '$opt->{value}')";
 	$opt->{value} = undef;
	return
    }
    $opt->{value} = $value;
}
sub usage {
    STDERR->print('Usage: ');
    my $string=undef;
    foreach (keys %opts) {
	if ($opts{$_}->{stage} & ENV_OPTS) {
	    my $notate=$opts{$_}->{notate}
	    ? "=$opts{$_}->{notate}" : '=<anything>';
	    $string = ($string // 'export') . " $_$notate";
	}
    }
    STDERR->print($string . ' ' ) if $string;
    STDERR->print($Script);
    foreach (keys %opts) {
	if ($opts{$_}->{stage} & ARG_OPTS) {
	    my $notate=$opts{$_}->{notate} ? '=' . $opts{$_}->{notate} : '';
	    STDERR->print(" [--$_$notate]");
	}
    }
    stderr->print("\n\nREQUEST:\n");
    foreach (keys %opts) {
	if ($opts{$_}->{stage} & REQ_OPTS) {
	    stderr->print("$_=" . ($opts{$_}->{notate} // '') . "\n");
	}
    }
    foreach (keys %opts) {
	next unless $opts{$_}->{stage} & (ENV_OPTS | ARG_OPTS | REQ_OPTS);
	my $ex;
	$ex = $opts{$_}->{desc}->($opts{$_}) if $opts{$_}->{desc};
	$ex = ($ex ? "$ex\n\t" : '' ) . $opts{$_}->{expl} if $opts{$_}->{expl};
	stderr->print("$_: $ex\n") if $ex;
    }
    STDERR->print(
	"\n\n"
	. 'paramters passed on the command line take precedence over'
	. ' those set in the environment, and parameters passed in the'
	. ' request take precedence over both.'
	. "\n"
	);
};

# Env Var Handling
##############################################################################
$gettype='$';
warn "reading env" if opt('debug');
foreach (keys %opts) {
    if ($opts{$_}->{stage} & ENV_OPTS) {
	my $v = $ENV{$_};
	warn "validate_opts($_, $v)" if defined $v && opt('debug');
	validate_opts($_, $v) if defined $v;
    };
};

# Command-line Option Handling
##############################################################################

$gettype='--';
my $options = {};
warn "building args" if opt('debug');
foreach (keys %opts) {
    my $t = $opts{$_}->{type};
    warn "$_ doesn't have a type defined" && next unless defined $t;
    $t = "=$t" unless '!' eq $t;
    $options->{$_ . $t} = \&validate_opts if ($opts{$_}->{stage} & ARG_OPTS);
}
warn "reading args" if opt('debug');
my $getopt_result = GetOptions %$options;

if (not $getopt_result) {
    usage();
    exit(255);
}

if (opt('help')) {
    usage();
    exit(0);
}

if (opt('version')) {
    print("spfd version $VERSION (using Mail::SPF)\n");
    exit(0);
}

my $default_explanation = $options->{'default-explanation'};
my $hostname            = opt('hostname');



# Main Program
##############################################################################

STDOUT->autoflush(TRUE);

my $spf_server = Mail::SPF::Server->new(
    default_authority_explanation => $default_explanation,
    hostname        => opt('hostname'),
    );

# Handle Client Connections
##############################################################################
my $listen_socket = IO::Socket->new_from_fd(0,'r+');
print("spfd (PID $$): Listening on socket '",
      Socket::sockaddr_un( $listen_socket->sockname),
      "'\n") if (opt('debug'));

my $procs = opt('listeners');
while (1) {
    my $pid;
    my $attempts = opt('forkretry');

    warn "$$ = $procs";
    while ($procs) {
	warn "$$ : $procs";
	$pid = fork();
	warn "print fork ($!) =";# if opt('debug');
	warn "failed to fork ($procs to go)" && sleep(1) unless defined $pid;
	last unless $pid;
	$procs--;
    }
    warn "print fork = $pid" if opt('debug');
    last if (0 == $pid);
    
    $procs++ if wait > 0;
}
# Child process.
my $socket;
$socket =  $listen_socket->accept();
die "Child $$ got an empty socket $!" unless $socket;
close($listen_socket);

my $time = gmtime;
if (opt('debug')) {
    my $peerinfo =
	$listen_socket->isa('IO::Socket::INET') ?
	sprintf(" from %s [%s]", scalar(gethostbyaddr($socket->peeraddr, AF_INET)), $socket->peerhost)
	:   '';
    print("\n");
    print("[$time] Incoming connection" . $peerinfo . "\n");
}

try {
    $socket->autoflush(TRUE);
    
    my $request_values = {};
    while (<$socket>) {
	s/\s+$//;
	last if /^$/;
	my ($key, $value) = split(/=/, $_, 2);
	warn "request option $key not recognised" && next
	    unless ($opts{$key}->{stage} // 0 ) & REQ_OPTS;
	$opts{$key}->{value} = $value;
	
	print("[$time] R: $key=$value\n")
	    if opt('debug');
    }
    
    my $request = Mail::SPF::Request->new(
	versions        => [1],
	scope           => opt('scope'),
	identity        => ((opt('scope') eq 'helo')
			    ? opt('HELOHOST')
			    : opt('MAILFROM')),
	ip_address      => opt('TCPREMOTEIP'),
	helo_identity   => opt('HELOHOST')
        );
    
    my $result = $spf_server->process($request);
    
    
    print($result->local_explanation);
    $socket->print('H', $result->received_spf_header, "\n");
    $socket->print('Sspp-spf-result=', $result->code, "\n");


catch Mail::SPF::Exception with {
    my ($e) = @_;
    printf("[$time] An error occurred: %s\n", $e->text);
};

$socket->close();




