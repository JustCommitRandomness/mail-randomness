#!/command/execlineb
/home/justin.roberts/dev/package/mail-randomness/package/execline-scripts/stderr-to-stdout-with-tag
importas -D /command/		tmpc	SLASHPACKAGE_COMMAND
/command/multisubstitute {
	importas -D /command/		tmpel	EXECLINE_COMMAND
	importas -ui			service	SCANDIR
	importas -ui			Tag	SCANTAG
}
importas -D /etc/${Tag}/${service}	confdir	ETC
export ETC $confdir
${tmpc}importas -D $tmpc		tmpmr	MAILRANDOMNESS_COMMAND
##########################################################################
${tmpmr}explode-servicedir	# grok the directory name to load config #
##########################################################################

${tmpel}importas -D	$tmpc		c	SLASHPACKAGE_COMMAND
${tmpel}importas -D	$tmpel		el	EXECLINE_COMMAND
${el}multisubstitute {
	importas -D	${c}		mr	MAILRANDOMNESS_COMMAND
	importas -iS				PATH
	importas -D	${c}/s6- 	s6	S6_COMMAND
	importas -D	/var/run/	rundir	SOCKETEERS_RUN
	importas -uD	$PATH		expath	SOCKETEERS_PATH
	importas -uD	$PATH		LP	LAUNCHPATH
	importas -ui			here	where
	importas -uSi				basename
	importas -uSi				dirname
	importas -uSi				base
	importas -uSi				UID
	importas -uSi				GID
	importas -uSD	660			SOCKET_PERMS
	importas -uSD	$base			LISTENER
	importas -uS				LISTENER_ARGS
}
${el}importas -uSD ${rundir}/${base}/${basename} SOCKET_PATH
${el}backtick -Ei socketdir { dirname $SOCKET_PATH }
foreground {
	echo rundir: \"${rundir}\" base: \"${base}\" basename: \"${basename}\"
	SOCKET_PATH: \"${SOCKET_PATH}\" socketdir: \"${socketdir}\"
}
${el}ifthenelse { ${el}eltest -d $socketdir }
{ } {
	${el}foreground {
		${el}fdswap 1 2
		echo Something seems wrong: Making socketdir $socketdir
		in $dirname / $basename 
	}
	mkdir -pm u=rwx,go=rx	$socketdir }

${s6}ipcserver-socketbinder -B $SOCKET_PATH
foreground { 
	${el}multisubstitute {
		importas -uSD $UID	SOCKET_UID
		importas -uSD $GID	SOCKET_GID
	}
	chown ${SOCKET_UID}:${SOCKET_GID} $SOCKET_PATH
}
${mr}envulimit
${s6}applyuidgid
${el}export PATH $expath	# set the path export will to find the plugin
${el}export PATH $LP		# set the path the plugin will use
foreground { printenv }
foreground { echo \"$LISTENER\" \"$LISTENER_ARGS\" }
$LISTENER $LISTENER_ARGS
