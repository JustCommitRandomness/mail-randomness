#warm up NetAddr:IP for prefork and unveil
{
    use NetAddr::IP;
    my $unused = NetAddr::IP->new('127.0.0.1', 8) . NetAddr::IP->new('::1', 8);
}

unveil('/', '');
unveil('/etc/resolv.conf', 'r');
unveil();

STDOUT->autoflush(TRUE);
STDERR->autoflush(TRUE);
    
$SIG{'USR1'} = $SIG{'USR2'} = 'IGNORE';
$SIG{'HUP'} = $SIG{'TERM'} = $SIG{'INT'} = sub {
    my $sig = shift;
    $sig = 'TERM' if ('HUP' eq $sig);
    kill('USR1', -$$);
    $SIG{'HUP'} = $SIG{'TERM'} = $SIG{'INT'} = 'DEFAULT';
    print("$$: received $sig ($!)\n");
    exit 0;
};
my @bouncelevel = qw(fail softfail neutral none error unknown pass);
my %levelbounce = ('always' => -1);
$levelbounce{$bouncelevel[$_]} = $_ for (0..$#bouncelevel);
my @possible_all = qw(pass softfail neutral neutral-by-default fail);
my @possible_results = (keys %{Mail::SPF::Result->result_classes}, 'Policy');

my %opts = (
#likely set by envdir
    'LISTENERS' => {
	value => 5,
	stage => START_UP,
	type => 'i',
	test => sub { my $v = shift;
		      return 0 <= $v
			  && 10 >= $v; },
	expl => 'must be between 1 and 10',
	notate => '<n>',
	desc => sub {
	    my $self = shift;
	    'Attempt to keep'
		. ' ' . ($self->{notate})
		. ' Child processes ready.'
		. '  A value of 0 skips preforking, turning into'
		. ' a one shot '
	}
    }
    , 'SOCKET_ON_FD' => {
	value => 0,
	stage => START_UP,
	type => 'i',
	test => sub { my $v = shift;
		      return $v =~ m/\d+/ <= $v;
	},
	expl => 'Must be a file descriptor pointing to a socket'
    }
    , 'LOCALHOST' => {
	value => undef,
	stage => START_UP,
	type => 'hostname',
	notate => '<label>',
	test => sub { TRUE },
	desc => sub { 'the hostname to use for the reporting'
			  . ' server, possibly overridden by TCPLOCALHOST '
	}
    }
    , 'SPF_USETCPLOCALHOST' => {
	value => undef,
	stage => ANY_OPTS,
	type => '!',
	notate => '<label>',
	test => sub { TRUE },
	desc => sub { 'the default hostname to use for the reporting'
			  . ' server, almost certain to be overwitten'
			  . ' by the request'
	}
    }
#likely set by args
    , 'help' => {
	value => FALSE,
	stage => ARG_OPTS,
	type => '!',
	test => sub { TRUE },
	desc => sub { 'print help usage and exit' },
    }
    , 'version' => {
	value => FALSE,
	stage => ARG_OPTS,
	type => '!',
	test => sub { TRUE },
	desc => sub { 'print help usage and exit' },
    }
    , 'scope' => {
	value => 'mfrom',
	stage => ANY_OPTS,
	type => 's',
	test => sub { my $v = shift;
		      return $v =~ m/^(mfrom|helo)$/
	},
	expl => 'only mfrom is recommended, but helo is supported',
	notate => '<type>',
	desc => sub { 'Which statement to check, MAIL FROM OR EHLO/HELO' },
    }
    , 'debug' => {
	value => 1,
	stage => ANY_OPTS,
	type => 'i',
	desc => sub { 'set debug level' }
    }
# likely set by request
    , 'SPFBOUNCELEVEL' => {
	VALUE => undef,
	stage => ANY_OPTS,
	type => 'i',
	test => sub { my $v = shift; -1 <= $v <= 5 },
	notate => '<level>',
	desc => sub {
	    my $self = shift;
	    my $str =  'compatability shim for ra-plugins spfchecks.'
		. ' If the result scores'
		. ' ' . $self->{notate}
		. ' or higher, the message will be rejected.'
		. "\n"
		. '-1 means never reject a messge.';
	    $str .= "\n$_ means reject on $bouncelevel[$_]"
		for (0..$#bouncelevel);
	    return $str;
	}
    }
    , 'SMTPHELOHOST' => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<hostname>',
	desc => sub {
	    ('The EHLO/HELO SMTP transaction parameter. Used for the'
	     . ' expansion of %{h} macros and during the policy evaluation of'
	     . ' the helo scope.') }
    }
    , 'SMTPMAILFROM' => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<hostname>',
	desc => sub {
	    ('The MAIL FROM SMTP transaction parameter. Used for the'
	     . ' expansion of %{s} and ${o} macros and during the policy'
	     . ' evaluation of the mfrom scope.') }
    }
    , 'TCPLOCALHOST' => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<ip address>',
	desc => sub {
	    ('The hostname to use for the reporting server in macro'
	    . 'expansions, overwritting HOSTNAME') },
    }
    , 'TCPREMOTEHOST' => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<ip address>',
	desc => sub {
	    ('The reverse lookup of the connecting IP address') },
    }
    , 'TCPREMOTEIP' => {
	value => undef,
	stage => REQ_OPTS,
	type => 's',
	test => sub { TRUE },
	notate => '<ip address>',
	desc => sub {
	    ('The IP address of the host claiming the identity that is being'
	     . ' checked.  Can be either an IPv4 or an IPv6 address. '
	     . ' An IPv4-mapped IPv6 address (e.g."::ffff:192.168.0.1") is'
	     . ' treated as an IPv4 address.') },
    });

my %actions=('ALL'=>0);
my $actre;
{
    my $all=0;
    my @acts = qw(LOG_SPF ADD_HEADER ADD_ENV PASS TEMPFAIL PERMFAIL ABORT);
    $actions{ALL}|=$actions{$acts[$_]}=1<<$_ for (0 .. $#acts);
    $actre = qr/^(?:~ALL|${\join('|[+~ ]?', @acts)})$/;
}

for my $spfres (@possible_results) {
    $opts{"handle_${spfres}"} = {
	value => $actions{LOG_SPF}|$actions{TEMPFAIL},
	stage => ANY_OPTS,
	type => 'bitmask',
	test => sub { my $v = shift; return m/$actre/; },
	expl => 'must be a actions bitmask. see --help',
	notate => '<bitmask>',
	desc => sub {
	    my $self = shift;
	    'modify the current actions for this result according to'
		. ' ' . ($self->{notate})
	}
    };
}
$opts{'handle_pass'}->{value} =
    $actions{LOG_SPF} | $actions{ADD_HEADER} | $actions{PASS};
$opts{'handle_fail'}->{value} =
    $actions{LOG_SPF} | $actions{ABORT};
lock_keys(%opts);

# Helper Functions
##############################################################################
sub debug {
    my (undef, $file, $line) = caller(0);
    $file =~ s!.*/!!;
    print "DBG: $file($$):$line\t", @_, "\n"
}
sub safestring {
    my $str = shift;
    return $str =~ s/\n$//r
	=~ s/([\\\"\'^])/\\$1/gr
	=~ s/([\p{Cc}])/ lc charnames::unctrl($1) /gre;
}
sub opt {
    my $option = shift;
    croak "'$option' not an option" unless exists $opts{$option};
    $opts{$option}->{value};
}
sub opt_or_die {
    my $option = shift;
    my $value;
    defined($value = opt($option))
	? $value : die "$option must be set";
}
sub or_undef {
    shift // '<undef>'
}
sub stringify_request {
    my $r = shift;
    'request.' . or_undef($r->scope)
	. '("' . or_undef($r->identity) . '", '
	    . or_undef($r->ip_address)
	    . ', "' . or_undef($r->helo_identity) . '")'
}
my $gettype='';
sub validate_opts {
    my ($optname, $value) = @_;
    debug("validating '$optname' '$value' (@_)") if opt('debug');
    my $opt = $opts{$optname};
    my $reason;
    if (!defined $opt->{type}) {
	warn "undefined option type for $optname";
    } elsif ('i' eq $opt->{type}) {
	$reason = 'Expected an integer' unless ($value =~ m/^[-+]?[0-9]+$/);
	$value += 0;
    } elsif ('!' eq $opt->{type}) {
	$value = $value // FALSE ? TRUE : FALSE;
    } elsif ('s' eq $opt->{type}) {
	0;
    } elsif ('hostname' eq $opt->{type}) {
	my $newvalue = validate_hostname($value);
	$reason = "poorly formed hostname $value (try $newvalue)";
	$value = $newvalue;
    } else {
	warn "unrecognised option type '$opt->{type}' for $optname";
    }
    $reason = $opt->{expl} unless
	defined($reason) || !defined($opt->{test}) || $opt->{test}->($value);
    if ($reason) {
	warn "${gettype}${optname} = '${value}' : ${reason}"
	    . "\n( was '$opt->{value}')";
 	$value = undef;
    }
    $opt->{value} = $value;
}
sub validate_hostnames {
    my $copy = my $value = shift;
    debug("validating hostname '$value'") if opt('debug');
    my $reason;
    my $trail = $value =~ s/\.+$// ? '.' : '';
    if ($reason = $value =~ s/(\.($!\.)|[^.]*+)(\.\.++)/$1  >> $2 << /gr
	&& $reason ne $value) {
	warn "stripping empty subdomains: $reason";
	$value =~ s/\.\.++//;
    }
    warn "stripped leading . from hostname '$copy'" if $value =~ s/^.//;
    warn "truncating to $1";
    if ($value =~ m/^(.{253})./) {
    }
    $value .= $trail;
    warn "FQDN recommended (trailing dot)" unless $trail || $value ne $copy;
    return $value;
}
sub usage {
    my (undef, $Script) = caller(0);
    STDERR->print('Usage: ');
    my $string=undef;
    foreach (keys %opts) {
	if ($opts{$_}->{stage} & ENV_OPTS) {
	    my $notate=$opts{$_}->{notate}
	    ? "=$opts{$_}->{notate}" : '=<anything>';
	    $string = ($string // 'export') . " $_$notate";
	}
    }
    STDERR->print($string . ' ' ) if $string;
    STDERR->print($Script);
    foreach (keys %opts) {
	if ($opts{$_}->{stage} & ARG_OPTS) {
	    my $notate=$opts{$_}->{notate} ? '=' . $opts{$_}->{notate} : '';
	    STDERR->print(" [--$_$notate]");
	}
    }
    stderr->print("\n\nREQUEST:\n");
    foreach (keys %opts) {
	if ($opts{$_}->{stage} & REQ_OPTS) {
	    stderr->print("$_=" . ($opts{$_}->{notate} // '') . "\n");
	}
    }
    foreach (keys %opts) {
	next unless $opts{$_}->{stage} & (ENV_OPTS | ARG_OPTS | REQ_OPTS);
	my $ex;
	$ex = $opts{$_}->{desc}->($opts{$_}) if $opts{$_}->{desc};
	$ex = ($ex ? "$ex\n\t" : '' ) . $opts{$_}->{expl} if $opts{$_}->{expl};
	stderr->print("$_: $ex\n") if $ex;
    }
    STDERR->print(
	"\n\n"
	. 'paramters passed on the command line take precedence over'
	. ' those set in the environment, and parameters passed in the'
	. ' request take precedence over both.'
	. "\n"
	);
};

# Env Var Handling
##############################################################################
$gettype='$';
debug("reading env") if opt('debug');
foreach (keys %opts) {
    if ($opts{$_}->{stage} & ENV_OPTS) {
	my $v = $ENV{$_};
	debug("validate_opts($_, $v)") if defined $v && opt('debug');
	validate_opts($_, $v, FALSE) if defined $v;
    };
};

# Command-line Option Handling
##############################################################################

$gettype='--';
my $options = {};
debug("building args") if opt('debug');
foreach (keys %opts) {
    my $t = $opts{$_}->{type};
    unless (defined $t) {
	warn "$_ doesn't have a type defined";
	next;
    }
    if ('bitmask' eq $t) { $t = '=s' }
    elsif ('hostname' eq $t) { $t = '=s' }
    elsif ('!' ne $t) { $t = "=$t" }
    $options->{$_ . $t} = \&validate_opts
	if ($opts{$_}->{stage} & ARG_OPTS);
}
warn "reading args" if opt('debug');
my $getopt_result = GetOptions %$options;

if (not $getopt_result) {
    usage();
    exit(255);
}

if (opt('help')) {
    usage();
    exit(0);
}

if (opt('version')) {
    print("spfd version $VERSION (using Mail::SPF)\n");
    exit(0);
}

my $default_explanation = $options->{'default-explanation'};

# Main Program
##############################################################################

STDOUT->autoflush(TRUE);

my $spf_server = Mail::SPF::Server->new(
    default_authority_explanation => $default_explanation,
    hostname        => opt('LOCALHOST'),
    );

my $listen_socket = IO::Socket->new_from_fd(0,'r+');
print(__FILE__ . "(PID $$): Listening on socket ",
      Socket::sockaddr_un( $listen_socket->sockname),
      "'\n");
unless ($listen_socket) {
    die $!;
}
# Prefork
##############################################################################

my $procs = 0;
if (my $forks = opt_or_die('LISTENERS')) {
    while (1) {
	my $pid;

	if ($procs) {
	    debug("Launching children, currently $procs/$forks")
		  if opt('debug');
	} else {
	    print "Launching $forks children\n";
	}
	while ($forks > $procs) {
	    debug("$$ : $procs\n") if 3 < opt('debug');
	    $pid = fork();
	    unless (defined $pid) {
		warn "$! -- failed to fork ($procs/$forks)";
		sleep(1);
	    }
	    last unless $pid;	#no more forking, child or error
	    $procs++;
	}
	last if (0 == $pid);	#not the parent, so exit the loop
	$procs-- if $procs && 0 < wait;
    }
} else {
    warn 'not forking, single shot:';
}
# Child process.
##############################################################################
$SIG{'HUP'} = $SIG{'TERM'} = $SIG{'INT'} = 'DEFAULT';

# Handle Client Connections
##############################################################################
my $socket;
$socket = $listen_socket->accept();
$SIG{'USR1'} = 'IGNORE';	# don't die 
die "Child $$ got an empty socket $!" unless $socket;

close($listen_socket);

# read request
##############################################################################
my $request_values = {};
while (<$socket>) {
    s/\s+$//;
    last if /^$/;
    my ($key, $value) = split(/=/, $_, 2);
    debug("R: $key=$value\n") if 3 < opt('debug');
    my $stage;
    unless (exists($opts{$key})) {
	debug("request option $key not recognised")
	    if 4 < opt('debug');	# indisciminate info expected
	next;
    }
    unless (REQ_OPTS & $opts{$key}->{stage}) {
	print "option $key not valid in request\n"
	    if opt('debug');
	next;
    }
    $opts{$key}->{value} = $value;
}
    
$spf_server->{hostname} = ($opts{TCPLOCALHOST}->{value})
if $opts{SPF_USETCPLOCALHOST}->{value} && $opts{TCPLOCALHOST}->{value};
    
my $request = Mail::SPF::Request->new(
    versions        => [1],
    scope           => opt('scope'),
    identity        => (opt('scope') eq 'helo'
			? opt_or_die('SMTPHELOHOST')
			: opt_or_die('SMTPMAILFROM')),
    ip_address      => opt_or_die('TCPREMOTEIP'),
    helo_identity   => opt('SMTPHELOHOST')
    );

my $result;
try {
    $result = $spf_server->process($request);
}
catch ($e) {
    warn "spf_server->process(\n" . Dumper($request)
	. "\n) -> \n" . Dumper($e);
    qp_temperror(451, '4.7.24',
	       'SPF TempError at "' . $spf_server->hostname . '":'
	       . "\n" . 'DNS timeout for "' . $request->domain . '"')
	if $e isa Mail::SPF::EDNSTimeout;
    croak ('Unhandled error: ' . stringify_request($request)
	   . ' -> ' . $e->text);
};

#debug(Dumper $result);


# Communicate results to caller
##############################################################################
my $bl = opt('SPFBOUNCELEVEL');
if (defined $bl) {	#ra-plugins style
    debug("ra-plugins style: $bl") if 3 < opt('debug');
    my $res = $result->code;
    print "$res accepted: accepting all messages\n", exit 0 if $bl < 0;
    my $level = $levelbounce{$res};
    if (defined $level) {
	if ($level > $bl) {
	    debug("accepting on $level:$res (SPFBOUNCELEVEL=$bl)")
		if 2 < opt('debug');
	    exit 0
	}
	$socket->print("E550 Message rejected by server (SPF)\n");
	warn "rejecting on $level:$res (SPFBOUNCELEVEL=$bl)\n"
	    if 1 < opt('debug');
	exit 0;
    }
    warn "unhandled $res in SPFBOUNCELEVEL shim";
    exit 1;
}
# flexible style
debug("flexible style: ".opt('SPFBOUNCELEVEL')) if 3 < opt('debug');
my $retbits = opt("handle_$result->name");
warn "${result}:$retbits $result->local_explanation: $retbits\n"
    if opt('debug');
if ($retbits & $actions{LOG_SPF}) {
    defined opt($_) && print "$_:" . opt($_) . ' '
	for (qw(scope MAILFROM HELOHOST TCPREMOTEIP));
}
$socket->print('H', safestring($result->received_spf_header), "\n")
    if $retbits & $actions{ADD_HEADER};
$socket->print('SSPF_RESULT=', safestring($result->code), "\n")
    if $retbits & $actions{ADD_ENV};
exit 0 if $retbits & $actions{PASS}; # if it passes, it passes.
my $rej = 'E451' if $retbits & $actions{TEMPFAIL};
$rej    = 'E550' if $retbits & $actions{PERMFAIL};
$rej    = 'D'    if $retbits & $actions{ABORT};
unless (defined $rej) { # it hasn't passed, aborted or temp/perm-failed??
    warn __FILE__ . " misconfigured: no final disposition for $result->name";
    $rej = 'E451 Internal Error';
}
$socket->print("$rej-Message rejected by "
	       . safestring(opt('TCPLOCALHOST') // 'Mail Server')
	       ."\n$rej SPF: "
	       . safestring(
		   $result->can('authority_explanation')
		   ? "$result->authority_explanation"
		   : "rejected ($rej)")
	       ."\n");


$socket->close();




