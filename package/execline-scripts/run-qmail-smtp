#!/command/execlineb
fdmove -c 2 1
export PATH /command:/var/qmail/bin

ifelse -nX {
	forx -o 0 -E ctrlfile { rcpthosts databytes }
	ifelse { eltest -f /var/qmail/control/${ctrlfile} }
	{ exit 0 }
	foreground { echo /var/qmail/control/${ctrlfile} must exist }
	exit 125
}
{ exit 125 }
backtick -n where { pwd-to-subpath }
importas -iu there where
export SPPCONFFILE /etc/${there}/plugins

s6-envdir -I /etc/qmail/ENV
s6-envdir -I /etc/${there}/ENV

importas -D _qmaild UidGidUser UIDGIDUSER
backtick def_qmail_class { id -c $UidGidUser }
setclasscontext -L -Eu def_qmail_class
setclasscontext -I -Eu CLASS
s6-envuidgid -i ${UidGidUser}
#s6-applyuidgid -U -z 

foreground { service-start-email }

multisubstitute {
	importas -uD 10		MaxSmtpd	MAXSMTPD
	importas -uD 3		MaxSameSmtpd	MAXSAMESMTPD
	importas -uD 127.0.0.1	Address		IP
	importas -uD 2525	Port		PORT
	importas -uD 2		TCPv		TCPVERBOSITY
	importas -uD 1		TCPav		TCPACESSVERBOSITY
	importas -uD 5000	AccessTimout	ACCESSTIMEOUT
	importas -uD /var/qmail/bin
				LaunchPath	LAUNCHPATH
}

s6-tcpserver-socketbinder ${Address} ${Port}
s6-tcpserverd -v ${TCPv} -c ${MaxSmtpd} -C ${MaxSameSmtpd}
s6-tcpserver-access  -W -r -t ${AccessTimout} -v 3
export ${LaunchPath} PATH
qmail-smtpd
