#!/command/execlineb

backtick ENV { /usr/bin/env }
backtick -n DATE {
	/bin/date "+Date: %a, %e %b %Y %H:%M:%S %z"
} 
getcwd PWD
multisubstitute {
	importas -u	DATE				DATE
	importas -u	ENV				ENV
	importas -u	PWD				PWD
	importas -uD	root@localhost			rcpt	NOTIFY_TO
	importas -uD	/var/qmail/bin/qmail-inject	mail	NOTIFY_MAILCMD
}
heredoc 0 

"From: (auto start)
${DATE}
Subject: supervised service started from ${PWD}

${ENV}

End of notification
"

$mail $rcpt

