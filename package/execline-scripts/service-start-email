#!/command/execlineb

backtick ENV { /usr/bin/env }
backtick -n DATE {
	/bin/date "+Date: %a, %e %b %Y %H:%M:%S %z"
} 
getcwd PWD
importas -D		root				defrcpt	LOGUSER
multisubstitute {
	importas -uS						DATE
	importas -uS						ENV
	importas -uS						PWD
	importas -uD	$defrcpt			rcpt	NOTIFY_TO
	importas -uD	/var/qmail/bin/qmail-inject	mailer	NOTIFY_MAILCMD
	importas -s "\t" 				mailarg NOTIFY_MAILARGS
}
heredoc 0 

"From: (auto start)
${DATE}
Subject: supervised service started from ${PWD}

${ENV}

End of notification
"

$mailer $mailarg $rcpt

