#!/usr/bin/perl
use strict; use warnings;
use Cwd 'getcwd';
my ($base, $is_log, @parts);
{
  my $cwd = getcwd();
  $is_log =  ($cwd =~ s!/log/?$!!) ? 'log.' : '';
  my $M_octet	= qr/ (?: [0-1]?[0-9]{1,2} | 2[0-4][0-9] | 25[0-5] ) /x;
  my $M_proto	= qr/(?:(T(?:[Cc][Pp]))|(U(?:[Dd][Pp])))[_-]?/;
  my $M_ip	= qr/($M_octet(?:\.$M_octet){3})[_-]?/;
  my $M_prefix	= qr/(?:\+([0-2]?[0-9]|3[0-2]))[_-]?/;
  my $M_pnum	= qr/( [0-5]?[0-9]{1,4} | 6[0-4][0-9]{3} 
		     | 65[0-4][0-9]{2} | 655[0-2][0-9] | 6553[0-5] ) /x;
  my $M_pword	= qr/(?:[[:alpha:]][[:alnum:]]*)/;
  my $M_pname	= qr/($M_pword(?:[-_]$M_pword)*)/;
  my $M_port	= qr/(?:$M_pnum|$M_pname)/;
  my $M_prange	= qr/(?::$M_port(?:\.\.$M_port)?)/;
  my $M_netspec	= qr/(?: $M_proto? $M_ip? $M_prefix? $M_prange? )/x;

  my @cwd;
  my $all;
  my ($ip, $prefix, $port, $toport, $tcp, $udp,
      $pname, $topname, $long, $short);
  ($tcp, $udp, $ip, $prefix,
  $port, $pname, $toport, $topname)
    = @cwd if @cwd = $cwd =~ m|.*/.*?(?:$M_netspec)?$|;

  $ENV{'PROTO'} = 'TCP' if $tcp;
  $ENV{'PROTO'} = 'UDP' if $udp;
  $port = getservbyname($pname, $udp ? 'udp' : 'tcp') if $pname;
  $port = getservbyname($pname, $udp ? 'udp' : 'tcp') if $topname;
  $ENV{'PORT'} = $port if $port;
  $ENV{'TOPORT'} = $toport if $toport;
  $ENV{'PREFIX'} = $prefix if $prefix;
  $ENV{'IP'} = $ip if $ip;
  $ENV{'PROTO'} = 'TCP' if $tcp;
  $ENV{'PROTO'} = 'UDP' if $udp;
  $ENV{'PORT'} = getservbyname($pname, $tcp ? 'tcp' : 'udp') if $pname;
  $ENV{'TOPORT'} = getservbyname($pname, $tcp ? 'tcp' : 'udp') if $topname;
  
  ($ENV{'dirname'}, $ENV{'basename'}) = $cwd =~ m!^(.*)/(.*)$!;

  # pwd* mode splits on both '-' and '_'; new mode splits solely on '_'
  my $chars = ($0 =~ m{(?:^|/)pwd[^/]*$}) ? '^-_' : '^_';

  ($base, @parts) = $ENV{'basename'} =~ m/([$chars]+)/g;
  $ENV{'base'} = $base;
}
{
  my $conf = ($ENV{'ETC'}
	      // join( '/', ( grep {defined} (
				  $ENV{'ETCROOT'} // '/etc',
				  $ENV{SCANTAG}, $ENV{SCANDIR} ) ) ) )
      . '/';
  my @newargv =	( ('s6-envdir', '-I', 'ENV'),
		  ('s6-envdir', '-I', "$conf$base/${is_log}ENV"));
  
  my $w = $base;
  my $suffix = ".${is_log}ENV";
  foreach (@parts) {
      $w .= "/$_";
      push @newargv, 's6-envdir', '-I', $conf . $w . $suffix ;
  }
  $ENV{'where'} = $w;

  if (0 < @ARGV &&  $0 !~ m:/run$: ) {
    push @newargv, @ARGV;
  } else {
    my $prefix = $ENV{'Runscripts'} || 'run-';
    if ($is_log) {
	my $logger = $prefix . $is_log . $base;
        push @newargv, -e  $logger ? $logger : $prefix . "log";
    } else {
        push @newargv, $prefix . $base;
    }
  }
  print "$conf: '", join("' '", @newargv), "'\n" ;
      
  exec @newargv;
  exit ($!{ENOENT} ? 127 : 126);
}
